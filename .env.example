# Google Gemini API Key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng cho trích xuất Structured Output
GEMINI_MODEL=gemini-2.5-flash

# Độ phân giải DPI khi chuyển PDF scan sang ảnh
PDF_RENDER_DPI=250

# Dung sai làm tròn tiền (VNĐ) khi kiểm tra sub_total + vat_amount == total_amount
AMOUNT_TOLERANCE=1.0

# Đường dẫn Tesseract OCR (tuỳ chọn, chỉ dùng làm fallback khi không có API key)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
